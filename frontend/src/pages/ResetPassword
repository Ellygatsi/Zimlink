import { useMemo, useState } from "react";
import { Link, useNavigate, useSearchParams } from "react-router-dom";
import api from "@/lib/api";
import { toast } from "sonner";
import logo from "@/Assets/logo.png";

export default function ResetPassword() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const token = useMemo(() => searchParams.get("token") || "", [searchParams]);

  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [busy, setBusy] = useState(false);
  const [completed, setCompleted] = useState(false);

  const submit = async (e) => {
    e.preventDefault();

    if (!token) return toast.error("This password reset link is invalid.");
    if (password.length < 6)
      return toast.error("Password must contain at least 6 characters.");
    if (password !== confirmPassword)
      return toast.error("The passwords do not match.");

    setBusy(true);
    try {
      await api.post("/auth/password-reset/confirm-link", {
        token,
        new_password: password,
      });
      setCompleted(true);
      toast.success("Your password has been reset.");
    } catch (err) {
      const msg =
        err?.response?.data?.detail ||
        "This reset link is invalid or has expired.";
      toast.error(typeof msg === "string" ? msg : "Could not reset password.");
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center p-5 bg-white">
      <div className="w-full max-w-md">
        <div className="mb-6 text-center flex flex-col items-center">
          <img src={logo} alt="ZimLink" className="w-64 md:w-80 object-contain" />
        </div>

        <div className="rounded-2xl p-8 bg-neutral-100 border border-neutral-200 shadow-sm">
          {completed ? (
            <div className="text-center">
              <h1 className="text-2xl font-semibold text-black">Password updated</h1>
              <p className="mt-2 text-sm text-neutral-500">
                You can now sign in with your new password.
              </p>
              <button
                type="button"
                onClick={() => navigate("/login", { replace: true })}
                className="mt-6 w-full h-12 rounded-xl bg-green-600 text-white font-medium"
              >
                Sign in
              </button>
            </div>
          ) : (
            <form onSubmit={submit} className="space-y-5">
              <div>
                <h1 className="text-2xl font-semibold text-black">
                  Create a new password
                </h1>
                <p className="mt-2 text-sm text-neutral-500">
                  Choose a new password for your ZimLink account.
                </p>
              </div>

              {!token && (
                <div className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                  This reset link is invalid. Request a new one from the login page.
                </div>
              )}

              <div>
                <label className="text-xs font-medium tracking-widest text-neutral-500 uppercase">
                  New password
                </label>
                <div className="relative mt-2">
                  <input
                    type={showPassword ? "text" : "password"}
                    autoComplete="new-password"
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    minLength={6}
                    required
                    className="w-full h-11 rounded-lg px-3 pr-14 bg-white border border-neutral-200 outline-none focus:border-green-600 text-black"
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword((prev) => !prev)}
                    className="absolute inset-y-0 right-0 px-3 text-xs text-neutral-500"
                  >
                    {showPassword ? "Hide" : "Show"}
                  </button>
                </div>
              </div>

              <div>
                <label className="text-xs font-medium tracking-widest text-neutral-500 uppercase">
                  Confirm password
                </label>
                <input
                  type={showPassword ? "text" : "password"}
                  autoComplete="new-password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  minLength={6}
                  required
                  className="w-full mt-2 h-11 rounded-lg px-3 bg-white border border-neutral-200 outline-none focus:border-green-600 text-black"
                />
              </div>

              <button
                type="submit"
                disabled={busy || !token}
                className="w-full h-12 rounded-xl bg-green-600 text-white font-medium disabled:opacity-50"
              >
                {busy ? "Updating password…" : "Update password"}
              </button>

              <p className="text-sm text-center text-neutral-500">
                <Link to="/login" className="font-medium text-green-600">
                  Return to sign in
                </Link>
              </p>
            </form>
          )}
        </div>
      </div>
    </div>
  );
}
